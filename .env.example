# FamilyGuard Environment Configuration Example
# Copy this file to .env and configure your credentials.

# Database Configuration (PostgreSQL or SQLite fallback)
DATABASE_URL=sqlite:///./familyguard.db
# For PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/familyguard

# JWT Security
JWT_SECRET_KEY=familyguard_super_secure_secret_key_2026_dev
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# OpenAI API (Optional - intelligent deterministic safety rules activate automatically if empty)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# PayPal Sandbox Integration (Optional - simulated sandbox mode activates automatically if empty)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=
